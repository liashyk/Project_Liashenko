<Window x:Class="WpfLab7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Агрегатор фільмів" Height="500" Width="800"
        MinHeight="300" MinWidth="500">

    <Window.Resources>
        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Background" Value="#2E86AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#1B4F72">
            <TextBlock Text="Агрегатор фільмів"
                       Foreground="White" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0"
                    Background="#D6EAF8" Margin="0">
            <TextBlock Text="Дії" FontWeight="Bold" FontSize="14"
                       Margin="10,10,10,5"/>
            <Button Content="➕ Додати"
                    Style="{StaticResource ControlButton}"
                    Click="AddButton_Click"/>
            <Button Content="✏️ Редагувати"
                    Style="{StaticResource ControlButton}"
                    Click="EditButton_Click"/>
            <Button Content="🗑️ Видалити"
                    Style="{StaticResource ControlButton}"
                    Click="DeleteButton_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" Grid.Column="1"
                  x:Name="MoviesGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Назва"    Binding="{Binding Title}"    Width="*"/>
                <DataGridTextColumn Header="Режисер"   Binding="{Binding Director}" Width="*"/>
                <DataGridTextColumn Header="Рік"       Binding="{Binding ReleaseDate, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="Рейтинг"   Binding="{Binding AverageRating}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>