<Window x:Class="WpfLab7.MovieDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фільм" Height="300" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Назва:"/>
        <TextBox x:Name="TitleBox" Margin="0,0,0,8"/>

        <TextBlock Text="Режисер:"/>
        <TextBox x:Name="DirectorBox" Margin="0,0,0,8"/>

        <TextBlock Text="Рік виходу:"/>
        <DatePicker x:Name="ReleaseDatePicker" Margin="0,0,0,8"/>

        <TextBlock Text="Рейтинг:"/>
        <TextBox x:Name="RatingBox" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="80" Margin="0,0,8,0" Click="Ok_Click">OK</Button>
            <Button Width="80" Click="Cancel_Click">Скасувати</Button>
        </StackPanel>
    </StackPanel>
</Window>